<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>ackermann_ompl_plugins</name>
  <version>0.0.1</version>
  <description>OMPL Reeds-Shepp Ackermann planning core (MoveIt plugins optional at build time)</description>
  <maintainer email="mosal@todo.todo">mosal</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <depend>rclcpp</depend>
  <depend>eigen</depend>
  <depend>tf2</depend>
  <depend>tf2_geometry_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>nav_msgs</depend>

  <!-- ompl is found via CMake (system or CMAKE_PREFIX_PATH overlay); not an ament package here -->

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
